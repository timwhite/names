{% extends 'base.html.twig' %}

{% block body %}
<div class="card">

    {% if ismale %}
        {% set genderclass = 'button is-info is-light is-large is-fullwidth is-rounded' %}
    {% else %}
        {% set genderclass = 'button is-danger is-light is-large is-fullwidth is-rounded' %}
    {% endif %}
    <div class=" card-header ">
        <p class="has-text-centered card-header-title title">{{ person.name }} - Choose which name you like the most
        </p>
    </div>

    {{ form_start(form) }}

    <div class="columns card-content">


        <div class="column">
                {{ form_widget(form.name1, {'attr': {'class': genderclass}}) }}
        </div>
        &nbsp;
        <div class="column">
                {{ form_widget(form.name2, {'attr': {'class': genderclass}}) }}
        </div>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}