{% extends 'base.html.twig' %}

{% block body %}
    <div class="card">
        <h1 class="card-header-title card-header title">Who are you comparing as?</h1>
        <div class="card-content content">
        <ul>
        {% for person in people %}
            <li><a class="btn btn-warning" href="{{ path('name_rank_compare', {'person': person.id}) }}">{{ person.name }}</a>
                <a href="{{ path('name_rank_compare', {'person': person.id, 'gender': 'male'}) }}">(Just Boys)</a> <a href="{{ path('name_rank_compare', {'person': person.id, 'gender': 'female'}) }}">(Just Girls)</a>
            </li>
        {% endfor %}
        </ul>


        </div>
        <div class="card-footer">
            <a class="card-footer-item" href="{{ path('name_rank_person_name') }}">Add new person</a>
        </div>
    </div>


{% endblock %}