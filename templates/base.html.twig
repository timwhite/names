<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Name Ranking App{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar">
            <a class="navbar-item" href="{{ path('name_rank_compare_as') }}">Select comparison person</a>
            <a class="navbar-item" href="{{ path('name_rank_new') }}">Add Baby Names</a>
            <a class="navbar-item" href="{{ path('name_rank_names') }}">Show all names</a>
        </nav>
        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="notification is-danger">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        <section class="container">
        {% block body %}{% endblock %}
        </section>
    </body>
</html>
