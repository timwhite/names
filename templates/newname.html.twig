{% extends 'base.html.twig' %}

{% block body %}
    <div class="card">
        <header class="card-header">
        <h1 class="card-header-title">Add New Name</h1>
        </header>
        <div class="card-content">
        {{ form(newform) }}
        </div>
    </div>

    <div class="card">
        <header class="card-header">
            <h1 class="card-header-title">Existing names</h1>
        </header>
        <div class="card-content content">
            <ul>
                {% for name in names %}
                    <li>{{ name.name }} {% if name.ismale %}(Male){% else %}(Female){% endif %}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}